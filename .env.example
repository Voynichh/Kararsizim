SECRET_KEY=yerel-gelistirme-icin-sahte-deger
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Bos birakilirsa SQLite kullanilir.
# Yerelden Supabase'e baglanmak icin SESSION pooler (port 5432) adresi (bkz. DEPLOY.md):
# DATABASE_URL=postgresql://postgres.<proje-ref>:<PAROLA>@aws-0-<bolge>.pooler.supabase.com:5432/postgres
# Vercel'de TRANSACTION pooler (port 6543) adresi kullanilir; gercek degerleri asla repoya yazma.
DATABASE_URL=
# Admin paneli yolu (production'da tahmin edilemez bir deger kullan)
ADMIN_URL=admin/
# Sadece Vercel'de True: istemci IP'si proxy basligindan okunur
TRUST_PROXY_IP_HEADER=False
# Kapali test icin kayit davet kodu (en az 12 karakter). Bos ise kayit herkese aciktir.
SIGNUP_INVITE_CODE=
